{
  "repo": "nonofficialmine/promptsklad",
  "sections": {
    "Промпт": "prompts",
    "Скилл": "skills",
    "Кейс": "cases",
    "Хук": "hooks",
    "Плагин": "plugins",
    "Настройка": "settings",
    "MCP": "mcp",
    "Агент": "agents"
  },
  "fields": [
    {
      "id": "section",
      "label": "Раздел",
      "kind": "select",
      "required": true,
      "options": "sections"
    },
    {
      "id": "topic",
      "label": "Тема",
      "kind": "select",
      "options": "topics",
      "required": true
    },
    {
      "id": "post_title",
      "label": "Название",
      "kind": "input",
      "required": true,
      "min": 5,
      "max": 80
    },
    {
      "id": "post_body",
      "label": "Содержимое: промпт, конфиг, SKILL.md или описание кейса",
      "kind": "textarea",
      "required": true,
      "min": 20,
      "max": 6000
    },
    {
      "id": "purpose",
      "label": "Для чего",
      "kind": "textarea",
      "required": false,
      "max": 300
    },
    {
      "id": "usage",
      "label": "Как использовать",
      "kind": "textarea",
      "required": false,
      "max": 1000
    },
    {
      "id": "why",
      "label": "Почему работает / выводы",
      "kind": "textarea",
      "required": false,
      "max": 1000
    },
    {
      "id": "tags",
      "label": "Теги",
      "kind": "multiselect",
      "options": "tags",
      "required": false,
      "max": 5
    },
    {
      "id": "models",
      "label": "Модели",
      "kind": "input",
      "required": false,
      "max": 100
    },
    {
      "id": "comment",
      "label": "Комментарий",
      "kind": "textarea",
      "required": false,
      "max": 1000
    },
    {
      "id": "author_name",
      "label": "Имя автора",
      "kind": "input",
      "required": false,
      "max": 40
    }
  ],
  "topics": [
    "dev",
    "research",
    "design",
    "data",
    "content",
    "business",
    "learning",
    "other"
  ],
  "tags": [
    "code-review",
    "refactoring",
    "debugging",
    "tests",
    "security",
    "docs",
    "automation",
    "ci-cd",
    "git",
    "sql",
    "frontend",
    "backend",
    "tokens"
  ]
}
