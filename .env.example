# Vercel → Project → Settings → Environment Variables

# GitHub fine-grained token на репозиторий promptsklad: Contents + Pull requests = Read and write
GITHUB_TOKEN=
# Cloudflare Turnstile (бесплатно): https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SEO (необязательно)
# Свой домен вместо promptsklad.vercel.app
SITE_URL=
# Код подтверждения из Google Search Console (meta-тег, только content)
GOOGLE_SITE_VERIFICATION=
